{
    "name": "tracewick/laravel",
    "description": "Tracewick sampling profiler integration for Laravel",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "laravel/framework": "^12.0 || ^13.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "tracewick/tracewick": "^1.0@RC"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "laravel/octane": "^2.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.2"
    },
    "suggest": {
        "ext-excimer": "Required to collect samples",
        "laravel/octane": "Install ^2.24 for optional RoadRunner, Swoole, or OpenSwoole profiling"
    },
    "autoload": {
        "psr-4": {
            "Tracewick\\Bridge\\Laravel\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tracewick\\Bridge\\Laravel\\TracewickServiceProvider"
            ]
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "@cs:check",
            "@rector:check",
            "@stan",
            "@test"
        ],
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "rector:check": "rector process --dry-run",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
